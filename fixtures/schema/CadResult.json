{
  "$defs": {
    "CadFiles": {
      "additionalProperties": false,
      "properties": {
        "preview": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Preview"
        },
        "source": {
          "title": "Source",
          "type": "string"
        },
        "step": {
          "title": "Step",
          "type": "string"
        },
        "stl": {
          "title": "Stl",
          "type": "string"
        }
      },
      "required": [
        "stl",
        "step",
        "source",
        "preview"
      ],
      "title": "CadFiles",
      "type": "object"
    },
    "Check": {
      "additionalProperties": false,
      "properties": {
        "fix": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Fix"
        },
        "input_source": {
          "anyOf": [
            {
              "enum": [
                "scan",
                "snapped",
                "caliper",
                "user_confirmed"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Input Source"
        },
        "kind": {
          "enum": [
            "required",
            "advisory"
          ],
          "title": "Kind",
          "type": "string"
        },
        "limit": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Limit"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "note": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Note"
        },
        "reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reason"
        },
        "result": {
          "enum": [
            "pass",
            "fail",
            "not_computed"
          ],
          "title": "Result",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Value"
        }
      },
      "required": [
        "name",
        "kind",
        "result"
      ],
      "title": "Check",
      "type": "object"
    },
    "InputRevisions": {
      "additionalProperties": false,
      "properties": {
        "part_measurement_revisions": {
          "additionalProperties": {
            "type": "integer"
          },
          "title": "Part Measurement Revisions",
          "type": "object"
        },
        "reconstruction_revision": {
          "title": "Reconstruction Revision",
          "type": "integer"
        }
      },
      "required": [
        "reconstruction_revision",
        "part_measurement_revisions"
      ],
      "title": "InputRevisions",
      "type": "object"
    },
    "Placement": {
      "additionalProperties": false,
      "properties": {
        "rotation_quat": {
          "maxItems": 4,
          "minItems": 4,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Rotation Quat",
          "type": "array"
        },
        "translate_mm": {
          "maxItems": 3,
          "minItems": 3,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Translate Mm",
          "type": "array"
        }
      },
      "required": [
        "translate_mm",
        "rotation_quat"
      ],
      "title": "Placement",
      "type": "object"
    },
    "PrintSettings": {
      "additionalProperties": false,
      "properties": {
        "est_material_g": {
          "title": "Est Material G",
          "type": "integer"
        },
        "est_time_min": {
          "title": "Est Time Min",
          "type": "integer"
        },
        "estimate_method": {
          "enum": [
            "volume_formula",
            "slicer"
          ],
          "title": "Estimate Method",
          "type": "string"
        },
        "infill_pct": {
          "title": "Infill Pct",
          "type": "integer"
        },
        "layer_height_mm": {
          "title": "Layer Height Mm",
          "type": "number"
        },
        "material": {
          "title": "Material",
          "type": "string"
        },
        "orientation": {
          "title": "Orientation",
          "type": "string"
        },
        "supports": {
          "title": "Supports",
          "type": "boolean"
        }
      },
      "required": [
        "material",
        "layer_height_mm",
        "infill_pct",
        "orientation",
        "supports",
        "est_time_min",
        "est_material_g",
        "estimate_method"
      ],
      "title": "PrintSettings",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "cad_id": {
      "title": "Cad Id",
      "type": "string"
    },
    "checks": {
      "items": {
        "$ref": "#/$defs/Check"
      },
      "title": "Checks",
      "type": "array"
    },
    "error": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Error"
    },
    "files": {
      "anyOf": [
        {
          "$ref": "#/$defs/CadFiles"
        },
        {
          "type": "null"
        }
      ]
    },
    "input_revisions": {
      "$ref": "#/$defs/InputRevisions"
    },
    "notes": {
      "title": "Notes",
      "type": "string"
    },
    "placement": {
      "anyOf": [
        {
          "$ref": "#/$defs/Placement"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "print_settings": {
      "anyOf": [
        {
          "$ref": "#/$defs/PrintSettings"
        },
        {
          "type": "null"
        }
      ]
    },
    "stale": {
      "title": "Stale",
      "type": "boolean"
    },
    "status": {
      "enum": [
        "ok",
        "failed_checks",
        "error"
      ],
      "title": "Status",
      "type": "string"
    }
  },
  "required": [
    "cad_id",
    "status",
    "input_revisions",
    "stale",
    "files",
    "checks",
    "print_settings",
    "notes"
  ],
  "title": "CadResult",
  "type": "object"
}
