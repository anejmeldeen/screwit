{
  "$defs": {
    "ScanInput": {
      "additionalProperties": false,
      "properties": {
        "codec": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Codec"
        },
        "container": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Container"
        },
        "duration_s": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Duration S"
        },
        "hdr": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Hdr"
        },
        "mesh_units": {
          "anyOf": [
            {
              "enum": [
                "metres",
                "millimetres"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Mesh Units"
        },
        "type": {
          "enum": [
            "video",
            "photos",
            "mesh"
          ],
          "title": "Type",
          "type": "string"
        },
        "uri": {
          "title": "Uri",
          "type": "string"
        }
      },
      "required": [
        "type",
        "uri"
      ],
      "title": "ScanInput",
      "type": "object"
    },
    "Stage": {
      "additionalProperties": false,
      "properties": {
        "message": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Message"
        },
        "name": {
          "enum": [
            "frames",
            "geometry",
            "scale",
            "object_mask",
            "splat",
            "mesh",
            "parts"
          ],
          "title": "Name",
          "type": "string"
        },
        "progress": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Progress"
        },
        "state": {
          "enum": [
            "pending",
            "running",
            "done",
            "failed",
            "skipped"
          ],
          "title": "State",
          "type": "string"
        }
      },
      "required": [
        "name",
        "state"
      ],
      "title": "Stage",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "input": {
      "$ref": "#/$defs/ScanInput"
    },
    "reconstruction_revision": {
      "minimum": 0,
      "title": "Reconstruction Revision",
      "type": "integer"
    },
    "scan_id": {
      "title": "Scan Id",
      "type": "string"
    },
    "stages": {
      "items": {
        "$ref": "#/$defs/Stage"
      },
      "title": "Stages",
      "type": "array"
    },
    "status": {
      "enum": [
        "uploaded",
        "validating",
        "processing",
        "ready",
        "failed"
      ],
      "title": "Status",
      "type": "string"
    }
  },
  "required": [
    "scan_id",
    "created_at",
    "input",
    "status",
    "reconstruction_revision",
    "stages"
  ],
  "title": "Scan",
  "type": "object"
}
