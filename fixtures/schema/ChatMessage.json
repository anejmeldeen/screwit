  "additionalProperties": false,
  "properties": {
    "cards": {
      "default": [],
      "items": {
        "discriminator": {
          "mapping": {
            "cad_result": "#/$defs/CadResultCard",
            "parts_to_buy": "#/$defs/PartsToBuyCard",
            "repair_plan": "#/$defs/RepairPlanCard"
          },
          "propertyName": "type"
        },
        "oneOf": [
          {
            "$ref": "#/$defs/RepairPlanCard"
          },
          {
            "$ref": "#/$defs/CadResultCard"
          },
          {
            "$ref": "#/$defs/PartsToBuyCard"
          }
        ]
      },
      "title": "Cards",
      "type": "array"
    },
