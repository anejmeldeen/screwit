            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Rotation Quat",
          "type": "array"
        },
        "translate_mm": {
          "maxItems": 3,
          "minItems": 3,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Translate Mm",
          "type": "array"
        }
      },
      "required": [
        "translate_mm",
        "rotation_quat"
      ],
