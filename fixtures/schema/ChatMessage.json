{
  "$defs": {
    "BomLine": {
      "additionalProperties": false,
      "properties": {
        "buy_links": {
          "items": {
            "$ref": "#/$defs/BuyLink"
          },
          "title": "Buy Links",
          "type": "array"
        },
        "est_price_usd": {
          "minimum": 0,
          "title": "Est Price Usd",
          "type": "number"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "qty": {
          "minimum": 1,
          "title": "Qty",
          "type": "integer"
        },
        "spec": {
          "title": "Spec",
          "type": "string"
        }
      },
      "required": [
        "name",
        "spec",
        "qty",
        "est_price_usd",
        "buy_links"
      ],
      "title": "BomLine",
      "type": "object"
    },
    "BuyLink": {
      "additionalProperties": false,
      "properties": {
        "url": {
          "title": "Url",
          "type": "string"
        },
        "vendor": {
          "title": "Vendor",
          "type": "string"
        }
      },
      "required": [
        "vendor",
        "url"
      ],
      "title": "BuyLink",
      "type": "object"
    },
    "CadFiles": {
      "additionalProperties": false,
      "properties": {
        "preview": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Preview"
        },
        "source": {
          "title": "Source",
          "type": "string"
        },
        "step": {
          "title": "Step",
          "type": "string"
        },
        "stl": {
          "title": "Stl",
          "type": "string"
        }
      },
      "required": [
        "stl",
        "step",
        "source",
        "preview"
      ],
      "title": "CadFiles",
      "type": "object"
    },
    "CadResult": {
      "additionalProperties": false,
      "properties": {
        "cad_id": {
          "title": "Cad Id",
          "type": "string"
        },
        "checks": {
          "items": {
            "$ref": "#/$defs/Check"
          },
          "title": "Checks",
          "type": "array"
        },
        "error": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Error"
        },
        "files": {
          "anyOf": [
            {
              "$ref": "#/$defs/CadFiles"
            },
            {
              "type": "null"
            }
          ]
        },
        "input_revisions": {
          "$ref": "#/$defs/InputRevisions"
        },
        "notes": {
          "title": "Notes",
          "type": "string"
        },
        "placement": {
          "anyOf": [
            {
              "$ref": "#/$defs/Placement"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "print_settings": {
          "anyOf": [
            {
              "$ref": "#/$defs/PrintSettings"
            },
            {
              "type": "null"
            }
          ]
        },
        "stale": {
          "title": "Stale",
          "type": "boolean"
        },
        "status": {
          "enum": [
            "ok",
            "failed_checks",
            "error"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "cad_id",
        "status",
        "input_revisions",
        "stale",
        "files",
        "checks",
        "print_settings",
        "notes"
      ],
      "title": "CadResult",
      "type": "object"
