    "CadResultCard": {
      "additionalProperties": false,
      "properties": {
        "payload": {
          "$ref": "#/$defs/CadResult"
        },
        "type": {
          "const": "cad_result",
          "default": "cad_result",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "payload"
      ],
      "title": "CadResultCard",
      "type": "object"
    },
    "Check": {
      "additionalProperties": false,
      "properties": {
        "fix": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Fix"
        },
        "input_source": {
          "anyOf": [
            {
              "enum": [
                "scan",
                "snapped",
                "caliper",
                "user_confirmed"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Input Source"
        },
        "kind": {
          "enum": [
            "required",
            "advisory"
          ],
          "title": "Kind",
          "type": "string"
        },
        "limit": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Limit"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "note": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Note"
        },
        "reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reason"
        },
        "result": {
          "enum": [
            "pass",
            "fail",
            "not_computed"
          ],
          "title": "Result",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Value"
        }
      },
      "required": [
        "name",
        "kind",
        "result"
      ],
      "title": "Check",
      "type": "object"
    },
    "Diagnosis": {
      "additionalProperties": false,
      "properties": {
        "confidence": {
          "maximum": 1,
          "minimum": 0,
          "title": "Confidence",
          "type": "number"
        },
        "part_ids": {
          "items": {
            "type": "string"
          },
          "title": "Part Ids",
          "type": "array"
        },
        "summary": {
          "title": "Summary",
          "type": "string"
        }
      },
      "required": [
        "summary",
        "part_ids",
        "confidence"
      ],
      "title": "Diagnosis",
      "type": "object"
