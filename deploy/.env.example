# Copy to deploy/.env and fill in. deploy/.env is gitignored and holds the only copy of these secrets.
# No credential is ever committed to the repo (AGENTS.md decision 4, SPEC 3.3).

# --- Postgres (SPEC 3.1: records; reachable only on the compose network) ---
POSTGRES_USER=screwit
POSTGRES_PASSWORD=change-me-strong-random
POSTGRES_DB=screwit

# --- Redis (SPEC 3.1: RQ queue; reachable only on the compose network) ---
REDIS_PASSWORD=change-me-strong-random

# --- Storage signing key (local dev store URL/form integrity, SPEC 3.3) ---
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
# Omit to have the dev server generate a fresh key at start (invalidates old signed URLs on restart).
SCREWIT_STORAGE_SIGNING_KEY=

# --- S3 (deployed storage; private bucket from deploy/s3-bucket.yaml) ---
SCREWIT_S3_BUCKET=screwit-uploads-REPLACE
AWS_REGION=us-west-2

# --- LLM provider (AGENTS.md decision 4): openrouter | bedrock | anthropic | fake ---
SCREWIT_LLM=fake
# SCREWIT_MODEL=                 # required for a real provider, e.g. anthropic/claude-sonnet-4.5 on openrouter
# OPENROUTER_API_KEY=            # only when SCREWIT_LLM=openrouter; set in the shell, never committed
# ANTHROPIC_API_KEY=            # only when SCREWIT_LLM=anthropic; never committed
# AWS creds for SCREWIT_LLM=bedrock come from the host's environment/role, not from a file.

# --- Parts search API (optional; curated catalogue is the default, SPEC 6.3) ---
# PARTS_SEARCH_API_KEY=
